{
  "manifest_version": 3,
  "name": "Yoink",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "description": "Professional Full Page, Visible Viewport, Selection, and Multi-Tab Screenshot Tool.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads",
    "offscreen",
    "clipboardWrite",
    "desktopCapture",
    "alarms"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Yoink",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "index.html?tab=true",
    "open_in_tab": true
  },
  "commands": {
    "capture_full_page": {
      "suggested_key": { "default": "Alt+Shift+1", "mac": "Alt+Shift+1" },
      "description": "Capture entire page"
    },
    "capture_visible": {
      "suggested_key": { "default": "Alt+Shift+3", "mac": "Alt+Shift+3" },
      "description": "Capture visible part"
    },
    "capture_selection": {
      "suggested_key": { "default": "Alt+Shift+4", "mac": "Alt+Shift+4" },
      "description": "Capture selection"
    }
  }
}
